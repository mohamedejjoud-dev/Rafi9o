# Rafi9i Web — Frontend Environment Configuration
# ----------------------------------------------------
# Base URL of the Laravel REST API.
# For local development with Laravel running on port 8000:
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# For production:
# NEXT_PUBLIC_API_URL=https://api.rafi9i.co.uk/api/v1

# Public site URL used for canonical tags, Open Graph, and sitemaps:
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# For production:
# NEXT_PUBLIC_SITE_URL=https://rafi9i.co.uk

# Set to true for fallback demo/mock mode if backend is unreachable:
NEXT_PUBLIC_DEMO_MODE=false
